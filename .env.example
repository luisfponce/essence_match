# Copy to .env for local development. Keep real secrets out of Git.
PROJECT_NAME=essencematch
ENVIRONMENT=local

BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
API_V1_PREFIX=/api/v1
DATABASE_URL=postgresql+psycopg://app:change-me@postgres:5432/app
JWT_SECRET_KEY=change-this-local-development-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
FRONTEND_PORT=8080
VITE_API_BASE_URL=/api/v1
DB_NAME=app
DB_USER=app
DB_PASSWORD=change-me
DB_PORT=5432
REDIS_URL=redis://redis:6379/0
REDIS_PORT=6379
